      "stars": null,
      "ui_type": "all",
      "category": "ai-coding",
      "popular": false,
      "description": "开源 AI 编程代理。此目录保留官方 V1 的 opencode-ai 安装途径，不代表 V2 安装支持；未提供 V2 模型/MCP 配置读写适配器，保留 AGENTS.md 个性化写入。",
      "install": {
        "method": "npm",
        "command": "npm install -g opencode-ai",
        "verify_cmd": "opencode --version",
        "uninstall_cmd": "npm uninstall -g opencode-ai",
        "dependencies": [
          "node >= 18"
        ]
      },
      "auth_type": "api_key",
      "config_inject": {
        "skills": true,
