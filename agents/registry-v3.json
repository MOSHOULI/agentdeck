        "personalization": {
          "template": "opencode",
          "target": "~/.config/opencode/AGENTS.md"
        },
        "model_config": null
      },
      "memory_collector": "opencode_sessions",
      "icon": "opencode",
      "homepage": "https://opencode.ai"
    },
    "claude-code": {
      "name": "Claude Code",
      "source": "closed",
      "github": "anthropics/claude-code",
      "stars": null,
      "ui_type": "all",
      "category": "ai-coding",
      "popular": false,
      "description": "Anthropic 官方编程代理，提供交互式终端会话与账号认证。此目录使用 npm 安装途径，配置能力以 AgentDeck 已验证适配器为准。",
      "install": {
        "method": "npm",
        "command": "npm install -g @anthropic-ai/claude-code",
        "verify_cmd": "claude --version",
        "uninstall_cmd": "npm uninstall -g @anthropic-ai/claude-code",
        "dependencies": [
          "node >= 22",
          "git"
        ]
      },
      "auth_type": "oauth_cli",
      "auth_guide": {
        "steps": [
          "在终端运行 claude auth login 完成 Anthropic 账号认证",
          "也可通过 ANTHROPIC_API_KEY 环境变量使用 API Key 模式"
        ],
        "completion_check": {
          "file_exists": "~/.claude/credentials.json"
        }
      },
      "config_inject": {
        "skills": true,
        "mcp": {
          "file": "~/.claude.json",
          "format": "json_merge",
          "key": "mcpServers"
        },
        "memory": true,
        "personalization": {
          "template": "claude",
          "target": "~/.claude/CLAUDE.md"
        },
        "model_config": {
          "file": "~/.claude/settings.json",
          "format": "json_merge"
        }
      },
      "memory_collector": "claude_sessions",
      "icon": "claude-code",
      "homepage": "https://claude.com"
    },
